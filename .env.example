# ===============================================
# PIXLARK MARKETING - EMAIL & SERVER CONFIGURATION
# ===============================================

# Server Port
PORT=3000

# SMTP Configuration (e.g. Gmail, Brevo, SendGrid, Zoho, Hostinger, AWS SES)
# Leave blank to use Ethereal Mail preview in local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Addresses
EMAIL_FROM="Pixlark Marketing <contact@pixlarkmarketing.com>"
EMAIL_TO=contact@pixlarkmarketing.com
